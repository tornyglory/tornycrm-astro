---
---

<section class="calculator">
	<header class="calculator__head">
		<div class="calculator__lead">
			<span class="section-header__eyebrow">
				<span class="section-header__eyebrow-dot" aria-hidden="true"></span>
				Revenue calculator
			</span>
			<h2 class="calculator__title">
				Do the maths before<br />
				you sign.
			</h2>
		</div>
		<p class="calculator__sub">
			Plug in a rough month. We'll show you the Torny bill &amp; your take-home — and compare it against doing all this
			manually.
		</p>
	</header>

	<div class="calculator__card">
		<div class="calculator__inputs">
			<div class="calculator__inputs-head">Your month</div>
			<div class="calculator__inputs-list">
				<div class="calculator__field">
					<span class="calculator__field-label">Venue hire revenue</span>
					<div class="calculator__field-value">
						<span class="calculator__field-value-amount">$8,500</span>
						<span class="calculator__field-value-unit">/ month</span>
					</div>
					<div class="calculator__field-bar" aria-hidden="true">
						<span class="calculator__field-bar-fill" style="width: 62%;"></span>
					</div>
				</div>
				<div class="calculator__field">
					<span class="calculator__field-label">Bistro covers (members' revenue)</span>
					<div class="calculator__field-value">
						<span class="calculator__field-value-amount">$4,200</span>
						<span class="calculator__field-value-unit">/ month</span>
					</div>
					<div class="calculator__field-bar" aria-hidden="true">
						<span class="calculator__field-bar-fill" style="width: 42%;"></span>
					</div>
				</div>
				<div class="calculator__field">
					<span class="calculator__field-label">Event entries (tournaments)</span>
					<div class="calculator__field-value">
						<span class="calculator__field-value-amount">120 entries</span>
						<span class="calculator__field-value-unit">/ month</span>
					</div>
					<div class="calculator__field-bar" aria-hidden="true">
						<span class="calculator__field-bar-fill" style="width: 30%;"></span>
					</div>
				</div>
			</div>
		</div>

		<div class="calculator__outputs">
			<span class="calculator__outputs-glow" aria-hidden="true"></span>
			<span class="calculator__outputs-head">Your Torny bill</span>
			<div class="calculator__lines">
				<div class="calculator__line">
					<span class="calculator__line-label">Base plan</span>
					<span class="calculator__line-value">$80.00</span>
				</div>
				<div class="calculator__line">
					<span class="calculator__line-label">5% of $12,700 bookings</span>
					<span class="calculator__line-value">$635.00</span>
				</div>
				<div class="calculator__line">
					<span class="calculator__line-label">120 entries × $1</span>
					<span class="calculator__line-value">$120.00</span>
				</div>
			</div>
			<div class="calculator__total">
				<span class="calculator__total-label">Monthly total</span>
				<span class="calculator__total-value">$835</span>
			</div>
			<div class="calculator__keep">
				<span class="calculator__keep-label">You keep</span>
				<span class="calculator__keep-value">$11,865 / month</span>
				<span class="calculator__keep-note">
					That's 94% of what you'd have billed anyway — plus hours of volunteer time you can't put a price on.
				</span>
			</div>
		</div>
	</div>
</section>
