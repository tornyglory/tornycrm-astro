---
---

<section class="demo-alt">
	<h2 class="demo-alt__title">
		Not ready to book? <span class="demo-alt__title-soft">That's completely fine.</span>
	</h2>

	<div class="demo-alt__grid">
		<a href="https://app.torny.club/" class="demo-alt-card">
			<span class="demo-alt-card__icon" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 20 20">
					<path
						d="M10 3v14M3 10h14"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"></path>
				</svg>
			</span>
			<h3 class="demo-alt-card__title">Start the 30-day trial</h3>
			<p class="demo-alt-card__body">
				No card, no sales call, no onboarding fee. Spin up a workspace, import your member list, poke the venue hire
				wizard — on your own clock.
			</p>
			<span class="demo-alt-card__cta">
				Try it free
				<span aria-hidden="true">→</span>
			</span>
		</a>

		<a href="#tour" class="demo-alt-card">
			<span class="demo-alt-card__icon" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 20 20">
					<circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
					<path d="M8 7v6l5-3-5-3z" fill="currentColor"></path>
				</svg>
			</span>
			<h3 class="demo-alt-card__title">Watch the 90-second tour</h3>
			<p class="demo-alt-card__body">
				A silent screen-record of Thorndon Club going from blank page to first paid venue hire. Ends with the
				treasurer's Xero view.
			</p>
			<span class="demo-alt-card__cta">
				Play
				<span aria-hidden="true">→</span>
			</span>
		</a>

		<a href="mailto:hello@torny.co" class="demo-alt-card">
			<span class="demo-alt-card__icon" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 20 20">
					<rect x="3" y="5" width="14" height="10" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
					<path d="M3 6l7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
				</svg>
			</span>
			<h3 class="demo-alt-card__title">Email with questions</h3>
			<p class="demo-alt-card__body">
				hello@torny.co lands in the same inbox the founders read every morning. A real reply, usually by the next
				cuppa.
			</p>
			<span class="demo-alt-card__cta">
				hello@torny.co
				<span aria-hidden="true">→</span>
			</span>
		</a>
	</div>
</section>
