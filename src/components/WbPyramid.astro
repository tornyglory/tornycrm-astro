---
const row2 = [
	{
		name: "Hero · full bleed",
		sub: "Image · headline · CTA",
		accent: "sky",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="9" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M2 6l3-2 3 3 5-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>`,
	},
	{
		name: "Tournament draw",
		sub: "Brackets · live scores",
		accent: "violet",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3v4a4 4 0 0 0 8 0V3zM6 13h4M5 13h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>`,
	},
];

const row3 = [
	{
		name: "Corporate events",
		sub: "Enquiry · brief · approve",
		accent: "graphite",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="5" width="10" height="8" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M3 8h10M6 5V3h4v2" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>`,
	},
	{
		name: "Events calendar",
		sub: "RSVPs · filters",
		accent: "sky3",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3.5" width="11" height="10" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M2.5 7h11M5.5 3.5v-1.5M10.5 3.5v-1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>`,
	},
	{
		name: "Honour board",
		sub: "Life members · champs",
		accent: "primary-strong",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2l1.8 3.6L14 6l-3 3 0.8 4.2L8 11.5l-3.8 1.7L5 9 2 6l4.2-0.4z" fill="currentColor"></path></svg>`,
	},
];

const row4 = [
	{
		name: "Venue hire wizard",
		sub: "Revenue · Stripe deposit",
		accent: "primary",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="4" width="11" height="9" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M2.5 7h11M5.5 4V2.5M10.5 4V2.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>`,
		revenue: true,
	},
	{
		name: "Catering packages",
		sub: "Revenue · per-guest",
		accent: "ochre",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2v4a2 2 0 0 0 2 2v6M4 2v4a2 2 0 0 1-2 2M11 2v12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>`,
		revenue: true,
	},
	{
		name: "Membership join",
		sub: "Revenue · subs",
		accent: "mint",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="6" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M3 13.5c0-2.4 2.2-3.9 5-3.9s5 1.5 5 3.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>`,
		revenue: true,
	},
	{
		name: "Build new with AI",
		sub: "Describe · generate",
		accent: "ai",
		icon: `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2l1.6 3.6L13 7l-3.4 1.4L8 12l-1.6-3.6L3 7l3.4-1.4z" fill="currentColor"></path></svg>`,
	},
];
---

<section class="wb-pyr">
	<header class="wb-pyr__head">
		<span class="wb-pyr__eyebrow">
			<span class="wb-pyr__eyebrow-dot" aria-hidden="true"></span>
			How the system works
		</span>
		<h2 class="wb-pyr__title">
			Stack smart blocks.<br />
			<span class="wb-pyr__title-accent">Build a website.</span>
		</h2>
		<p class="wb-pyr__body">
			Choose from venue hire, catering, tournaments, membership. Drag them into order. Each one wires itself to your
			bookings, members and your books. Stack them up — you've got a website that pays rent.
		</p>
	</header>

	<div class="wb-pyr__stack">
		<div class="wb-pyr__row wb-pyr__row--top">
			<div class="wb-pyr__capstone">
				<div class="wb-pyr__capstone-icon" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 18 18">
						<path d="M3 4h12v10H3zM3 7h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
						<circle cx="5" cy="5.5" r="0.6" fill="currentColor"></circle>
						<circle cx="7" cy="5.5" r="0.6" fill="currentColor"></circle>
					</svg>
				</div>
				<div class="wb-pyr__capstone-text">
					<div class="wb-pyr__capstone-head">
						<span class="wb-pyr__capstone-name">Your club website</span>
						<span class="wb-pyr__capstone-live">
							<span class="wb-pyr__capstone-live-dot" aria-hidden="true"></span>
							Published
						</span>
					</div>
					<span class="wb-pyr__capstone-url">thorndonclub.co.nz</span>
				</div>
			</div>
		</div>

		{
			[row2, row3, row4].map((row, i) => (
				<div class={`wb-pyr__row ${i === 2 ? "wb-pyr__row--base" : ""}`}>
					{
						row.map((b) => (
							<article class={`wb-pyr__blk wb-pyr__blk--${b.accent} ${b.accent === "ai" ? "wb-pyr__blk--ai" : ""}`}>
								<div class="wb-pyr__blk-icon" aria-hidden="true" set:html={b.icon} />
								<div class="wb-pyr__blk-text">
									<span class="wb-pyr__blk-name">{b.name}</span>
									<span class={`wb-pyr__blk-sub ${(b as any).revenue ? "wb-pyr__blk-sub--revenue" : ""}`}>{b.sub}</span>
								</div>
							</article>
						))
					}
				</div>
			))
		}
	</div>
</section>
