---
---

<aside class="wizard-card" aria-label="Venue booking wizard preview">
	<div class="wizard-card__head">
		<div class="wizard-card__title">Book the Ballroom</div>
		<div class="wizard-card__step">Step 2 of 3</div>
	</div>

	<div class="wizard-card__progress" aria-hidden="true">
		<span class="wizard-card__progress-step wizard-card__progress-step--done"></span>
		<span class="wizard-card__progress-step wizard-card__progress-step--done"></span>
		<span class="wizard-card__progress-step"></span>
	</div>

	<div class="wizard-card__picker">
		<div class="wizard-card__picker-label">Choose a package</div>

		<div class="wizard-card__option wizard-card__option--selected">
			<span class="wizard-card__option-radio wizard-card__option-radio--active" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 20 20">
					<path
						d="M4 10l4 4 8-8"
						fill="none"
						stroke="currentColor"
						stroke-width="2.2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</span>
			<div class="wizard-card__option-body">
				<div class="wizard-card__option-title">Canapés + bar · "Twilight"</div>
				<div class="wizard-card__option-sub">8 bites, 3 hr open bar, cheese board grazing station</div>
			</div>
			<div class="wizard-card__option-price">$68 /pp</div>
		</div>

		<div class="wizard-card__option">
			<span class="wizard-card__option-radio" aria-hidden="true"></span>
			<div class="wizard-card__option-body">
				<div class="wizard-card__option-title">Plated three course</div>
				<div class="wizard-card__option-sub">Choice of two mains, dessert, wine on tables</div>
			</div>
			<div class="wizard-card__option-price">$95 /pp</div>
		</div>

		<div class="wizard-card__option">
			<span class="wizard-card__option-radio" aria-hidden="true"></span>
			<div class="wizard-card__option-body">
				<div class="wizard-card__option-title">BYO + venue only</div>
				<div class="wizard-card__option-sub">Space hire, bar staff provided, you cater</div>
			</div>
			<div class="wizard-card__option-price">$1,200</div>
		</div>
	</div>

	<div class="wizard-card__footer">
		<div class="wizard-card__total">
			<span class="wizard-card__total-meta">80 guests · deposit 20%</span>
			<span class="wizard-card__total-value">
				$5,440.00 <span class="wizard-card__total-value-sub">· deposit $1,088</span>
			</span>
		</div>
		<div class="wizard-card__actions">
			<a href="#" class="btn btn--sm btn--outline-dark">Back</a>
			<a href="#" class="btn btn--sm btn--dark">Continue →</a>
		</div>
	</div>
</aside>
