---
---

<div class="builder-spot__editor">
	<aside class="builder-spot__palette" aria-label="Block palette">
		<div class="builder-spot__palette-head">
			<span class="builder-spot__palette-title">Blocks</span>
			<span class="builder-spot__palette-hint">Drag &amp; drop</span>
		</div>

		<div class="builder-spot__palette-section">Revenue</div>

		<div class="builder-spot__block builder-spot__block--active">
			<span class="builder-spot__block-icon" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 16 16">
					<rect x="2.5" y="4" width="11" height="9" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
					<path d="M5 2v3M11 2v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
				</svg>
			</span>
			<div class="builder-spot__block-body">
				<div class="builder-spot__block-name">Venue hire wizard</div>
				<div class="builder-spot__block-status">On · Ballroom page</div>
			</div>
		</div>

		<div class="builder-spot__block builder-spot__block--active">
			<span class="builder-spot__block-icon" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 16 16">
					<circle cx="8" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
					<circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				</svg>
			</span>
			<div class="builder-spot__block-body">
				<div class="builder-spot__block-name">Bistro bookings</div>
				<div class="builder-spot__block-status">On · Restaurant page</div>
			</div>
		</div>

		<div class="builder-spot__block">
			<span class="builder-spot__block-icon" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 16 16">
					<circle cx="8" cy="6" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
					<path d="M3 14c0-2.5 2-4 5-4s5 1.5 5 4" fill="none" stroke="currentColor" stroke-width="1.6"></path>
				</svg>
			</span>
			<div class="builder-spot__block-body">
				<div class="builder-spot__block-name">Membership join</div>
				<div class="builder-spot__block-status">Available</div>
			</div>
		</div>

		<div class="builder-spot__block">
			<span class="builder-spot__block-icon" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 16 16">
					<rect x="2.5" y="3" width="11" height="10" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
					<path d="M2.5 7h11M6 3v10" fill="none" stroke="currentColor" stroke-width="1.6"></path>
				</svg>
			</span>
			<div class="builder-spot__block-body">
				<div class="builder-spot__block-name">Events calendar</div>
				<div class="builder-spot__block-status">Available</div>
			</div>
		</div>

		<div class="builder-spot__palette-section" style="padding-top: 8px;">Content</div>

		<div class="builder-spot__block">
			<span class="builder-spot__block-icon" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 16 16">
					<rect x="2.5" y="4" width="11" height="8" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
					<path d="M2.5 8l3-2 3 3 5-4" fill="none" stroke="currentColor" stroke-width="1.6"></path>
				</svg>
			</span>
			<div class="builder-spot__block-body">
				<div class="builder-spot__block-name">Hero + gallery</div>
				<div class="builder-spot__block-status">Available</div>
			</div>
		</div>
	</aside>

	<div class="builder-spot__preview" aria-label="Live preview">
		<div class="builder-spot__chrome">
			<div class="builder-spot__dots" aria-hidden="true">
				<span class="builder-spot__dot builder-spot__dot--red"></span>
				<span class="builder-spot__dot builder-spot__dot--yellow"></span>
				<span class="builder-spot__dot builder-spot__dot--green"></span>
			</div>
			<div class="builder-spot__url-wrap">
				<div class="builder-spot__url">
					thorndonclub.co.nz<span class="builder-spot__url-path">/venue-hire</span>
				</div>
			</div>
			<div class="builder-spot__chrome-actions">
				<span class="builder-spot__chip-draft">Draft</span>
				<span class="builder-spot__chip-publish">Publish</span>
			</div>
		</div>

		<div class="builder-spot__hero">
			<div class="builder-spot__hero-top">
				<div class="builder-spot__hero-brand">Thorndon Club</div>
				<div class="builder-spot__hero-nav">
					<span class="builder-spot__hero-nav-link">Members</span>
					<span class="builder-spot__hero-nav-link">Bistro</span>
					<span class="builder-spot__hero-nav-link">Venue hire</span>
					<span class="builder-spot__hero-nav-link">Join</span>
				</div>
			</div>
			<div class="builder-spot__hero-tag">The Ballroom · 180 pax</div>
			<div class="builder-spot__hero-title">Host the one they'll remember.</div>
			<div class="builder-spot__hero-copy">
				Weddings, 60ths, corporate end-of-years. Views over the harbour, 180 seated, 240 standing.
			</div>
		</div>

		<div class="builder-spot__block-panel">
			<span class="builder-spot__block-tag" aria-hidden="true">Venue hire wizard</span>
			<span class="builder-spot__block-panel-outline" aria-hidden="true"></span>
			<div class="builder-spot__panel-head">
				<div class="builder-spot__panel-title">Check your date</div>
				<div class="builder-spot__panel-step">Step 1 of 3</div>
			</div>
			<div class="builder-spot__fields">
				<div class="builder-spot__field">
					<span class="builder-spot__field-label">When</span>
					<span class="builder-spot__field-value">Sat 7 Mar 2026</span>
				</div>
				<div class="builder-spot__field">
					<span class="builder-spot__field-label">Guests</span>
					<span class="builder-spot__field-value">80 pax</span>
				</div>
				<div class="builder-spot__field">
					<span class="builder-spot__field-label">Event</span>
					<span class="builder-spot__field-value">Birthday</span>
				</div>
				<div class="builder-spot__field-cta">Check &amp; price →</div>
			</div>
			<div class="builder-spot__panel-note">
				<span class="builder-spot__panel-note-dot" aria-hidden="true"></span>
				<span class="builder-spot__panel-note-text">Available · Deposit held via Stripe</span>
			</div>
		</div>

		<div class="builder-spot__block-panel builder-spot__block-panel--light">
			<span class="builder-spot__block-tag" aria-hidden="true">Bistro bookings</span>
			<div class="builder-spot__panel-head">
				<div>
					<div class="builder-spot__panel-title">Book a table — Friday dinner</div>
					<div class="builder-spot__panel-sub">6:30 or 8:00 sitting · members pay members' price</div>
				</div>
				<div class="builder-spot__panel-flag">Only 12 seats left</div>
			</div>
			<div class="builder-spot__fields">
				<div class="builder-spot__field builder-spot__field--selected">
					<span class="builder-spot__field-label">Sitting</span>
					<span class="builder-spot__field-value">6:30 pm</span>
				</div>
				<div class="builder-spot__field">
					<span class="builder-spot__field-label">Party</span>
					<span class="builder-spot__field-value">4 guests</span>
				</div>
				<div class="builder-spot__field">
					<span class="builder-spot__field-label">Member #</span>
					<span class="builder-spot__field-value">0842</span>
				</div>
				<div class="builder-spot__field-cta builder-spot__field-cta--primary">Confirm table →</div>
			</div>
		</div>

		<div class="builder-spot__footer">
			<div class="builder-spot__footer-left">
				<span class="builder-spot__footer-tick" aria-hidden="true">
					<svg width="14" height="14" viewBox="0 0 14 14">
						<path
							d="M3 7l3 3 5-6"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
				<div class="builder-spot__footer-text">
					<div class="builder-spot__footer-title">This page is making you $4,620 this week</div>
					<div class="builder-spot__footer-meta">2 venue hires booked · 68 bistro covers · live</div>
				</div>
			</div>
			<div class="builder-spot__footer-link">View in Analytics →</div>
		</div>
	</div>
</div>
