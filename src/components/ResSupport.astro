---
---

<section class="res-support">
	<div class="res-support__inner">
		<span class="res-support__glow" aria-hidden="true"></span>

		<div class="res-support__lead">
			<span class="res-support__eyebrow">
				<span class="res-support__eyebrow-dot" aria-hidden="true"></span>
				Still stuck?
			</span>
			<h2 class="res-support__title">
				Talk to a human<br />
				<span class="res-support__title-accent">in Wellington hours.</span>
			</h2>
			<p class="res-support__body">
				Every club gets a real person. No chatbots, no overseas tickets. The team's small, local, and knows your
				clubroom by the second email.
			</p>
			<span class="res-support__status">
				<span class="res-support__status-dot" aria-hidden="true"></span>
				Online now · avg reply 11 min
			</span>
		</div>

		<div class="res-support__channels">
			<a href="#" class="res-channel">
				<span class="res-channel__icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 20 20">
						<path d="M3 4h14v10H8l-5 4V4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
					</svg>
				</span>
				<div class="res-channel__body">
					<h3 class="res-channel__title">Live chat</h3>
					<span class="res-channel__meta">In-app · 7am–7pm NZT</span>
				</div>
				<span class="res-channel__arrow" aria-hidden="true">→</span>
			</a>

			<a href="#" class="res-channel">
				<span class="res-channel__icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 20 20">
						<path d="M7 10a3 3 0 1 0-3-3M4 7v8a2 2 0 0 0 2 2h8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
						<circle cx="14" cy="11" r="3" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
					</svg>
				</span>
				<div class="res-channel__body">
					<h3 class="res-channel__title">Join the operators' Slack</h3>
					<span class="res-channel__meta">1,240 secretaries, treasurers, presidents</span>
				</div>
				<span class="res-channel__arrow" aria-hidden="true">→</span>
			</a>

			<a href="mailto:hello@torny.co" class="res-channel">
				<span class="res-channel__icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 20 20">
						<rect x="3" y="5" width="14" height="10" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
						<path d="M3 6l7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
					</svg>
				</span>
				<div class="res-channel__body">
					<h3 class="res-channel__title">hello@torny.co</h3>
					<span class="res-channel__meta">Replies by the next cuppa</span>
				</div>
				<span class="res-channel__arrow" aria-hidden="true">→</span>
			</a>

			<a href="#" class="res-channel">
				<span class="res-channel__icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 20 20">
						<circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
						<path d="M10 6v5l3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
					</svg>
				</span>
				<div class="res-channel__body">
					<h3 class="res-channel__title">Book an onboarding call</h3>
					<span class="res-channel__meta">30 min · screen-share · bring your committee</span>
				</div>
				<span class="res-channel__arrow" aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</section>
