---
import BuilderEditor from "./BuilderEditor.astro";
---

<section class="builder-spot">
	<header class="section-header">
		<div class="section-header__lead">
			<span class="section-header__eyebrow">
				<span class="section-header__eyebrow-dot" aria-hidden="true"></span>
				Website builder · your revenue engine
			</span>
			<h2 class="section-header__title">
				A website that <span class="builder-spot__accent">leases</span><br />
				your venue and <span class="builder-spot__accent">books</span><br />
				your bistro.
			</h2>
		</div>
		<p class="section-header__body">
			Drag the venue-hire block onto the ballroom page, drop a bistro-bookings block on the restaurant page, publish.
			Every visitor is now a potential paying customer — not a phone call for a volunteer to return on Monday.
		</p>
	</header>

	<BuilderEditor />
</section>
