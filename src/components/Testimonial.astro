---
---

<section class="testimonial">
	<div class="testimonial__lead">
		<span class="testimonial__eyebrow">
			<span class="testimonial__eyebrow-dot" aria-hidden="true"></span>
			Case study · Naenae Cosmopolitan Club
		</span>
		<blockquote class="testimonial__quote">
			"Our Saturday secretary used to spend six hours on reconciliations. Now she spends an hour on
			<span class="testimonial__quote-accent">actual club life</span> — and we've put $92k through venue hire this year
			that would've walked out the door."
		</blockquote>
		<div class="testimonial__attribution">
			<span class="testimonial__avatar" aria-hidden="true">GB</span>
			<div class="testimonial__person">
				<div class="testimonial__name">Grant Bailey</div>
				<div class="testimonial__role">President · Naenae Cosmopolitan</div>
			</div>
		</div>
	</div>

	<div class="testimonial__stats">
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Venue hire revenue</span>
			<span class="testimonial__stat-value">$92k<span class="testimonial__stat-up"> ↑</span></span>
			<span class="testimonial__stat-note">+312% YoY after switching to Torny</span>
		</div>
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Admin hours saved</span>
			<span class="testimonial__stat-value">22<span class="testimonial__stat-sub"> /wk</span></span>
			<span class="testimonial__stat-note">Volunteer time back to the actual club</span>
		</div>
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Member retention</span>
			<span class="testimonial__stat-value">94%<span class="testimonial__stat-up"> ↑</span></span>
			<span class="testimonial__stat-note">Auto renewals, not reminder phone calls</span>
		</div>
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Setup time</span>
			<span class="testimonial__stat-value">11 <span class="testimonial__stat-sub">days</span></span>
			<span class="testimonial__stat-note">From contract signed to first booking</span>
		</div>
	</div>
</section>
