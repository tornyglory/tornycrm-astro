---
import PricingPlan from "./PricingPlan.astro";
---

<section class="pricing">
	<header class="pricing__header">
		<span class="pricing__eyebrow">
			<span class="pricing__eyebrow-dot" aria-hidden="true"></span>
			Pricing
		</span>
		<h2 class="pricing__title">
			Less than a website.<br />
			<span class="pricing__title-soft">We only win when you do.</span>
		</h2>
		<p class="pricing__body">
			$80 a month gets you every module — website builder, venue hire, bistro bookings, membership, comms. Then 5% of
			bookings and $1 per event entry when you start earning. No per-user fees, no setup fees, no modules locked behind
			upgrades.
		</p>
	</header>

	<PricingPlan />
</section>
