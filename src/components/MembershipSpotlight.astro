---
---

<section class="split-spot">
	<div class="split-spot__lead">
		<span class="split-spot__eyebrow">
			<span class="split-spot__eyebrow-dot" aria-hidden="true"></span>
			Membership
		</span>
		<h2 class="split-spot__title">
			A member record that<br />
			<span class="split-spot__title-accent">actually tells the truth.</span>
		</h2>
		<p class="split-spot__body">
			Every renewal, every event entry, every bar tab lives on the member's profile. Your committee stops arguing about
			who's financial.
		</p>
		<ul class="split-spot__checks">
			<li class="split-spot__check">
				<span class="split-spot__check-tick" aria-hidden="true">
					<svg width="11" height="11" viewBox="0 0 11 11">
						<path
							d="M2 5.5l2.5 2.5L9 2.5"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
				<span class="split-spot__check-text">
					<b>Public join form</b> that posts straight into your committee's approval queue.
				</span>
			</li>
			<li class="split-spot__check">
				<span class="split-spot__check-tick" aria-hidden="true">
					<svg width="11" height="11" viewBox="0 0 11 11">
						<path
							d="M2 5.5l2.5 2.5L9 2.5"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
				<span class="split-spot__check-text">
					<b>Auto-renewals</b> on direct debit, with grace periods and dunning that handle the awkward.
				</span>
			</li>
			<li class="split-spot__check">
				<span class="split-spot__check-tick" aria-hidden="true">
					<svg width="11" height="11" viewBox="0 0 11 11">
						<path
							d="M2 5.5l2.5 2.5L9 2.5"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
				<span class="split-spot__check-text">
					<b>Tiers, concessions &amp; family bundles</b> — priced the way your club actually sells them.
				</span>
			</li>
		</ul>
		<div class="split-spot__cta">
			<a href="/platform/membership" class="btn btn--dark">Explore the member CRM →</a>
		</div>
	</div>

	<aside class="member-card" aria-label="Member profile preview">
		<div class="member-card__head">
			<span class="member-card__avatar" aria-hidden="true">RP</span>
			<div class="member-card__identity">
				<div class="member-card__name">Rohan Patel</div>
				<div class="member-card__meta">
					<span class="member-card__tier">Playing · Senior</span>
					<span class="member-card__id">Member #0842</span>
				</div>
			</div>
			<span class="member-card__status">Financial</span>
		</div>

		<div class="member-card__timeline">
			<div class="member-card__row">
				<span class="member-card__row-date">Oct 28</span>
				<span class="member-card__row-dot-slot" aria-hidden="true">
					<span class="member-card__row-dot member-card__row-dot--primary"></span>
				</span>
				<span class="member-card__row-text"><b>Sub renewed</b> · $240 direct debit</span>
				<span class="member-card__row-amount">$240</span>
			</div>
			<div class="member-card__row-rule" aria-hidden="true"></div>
			<div class="member-card__row">
				<span class="member-card__row-date">Oct 21</span>
				<span class="member-card__row-dot-slot" aria-hidden="true">
					<span class="member-card__row-dot member-card__row-dot--tangerine"></span>
				</span>
				<span class="member-card__row-text"><b>Spring Comp</b> · entry paid</span>
				<span class="member-card__row-amount">$12</span>
			</div>
			<div class="member-card__row-rule" aria-hidden="true"></div>
			<div class="member-card__row">
				<span class="member-card__row-date">Oct 14</span>
				<span class="member-card__row-dot-slot" aria-hidden="true">
					<span class="member-card__row-dot member-card__row-dot--mint"></span>
				</span>
				<span class="member-card__row-text"><b>Table 4</b> · lunch for 6, dietary noted</span>
				<span class="member-card__row-amount">—</span>
			</div>
		</div>
	</aside>
</section>
