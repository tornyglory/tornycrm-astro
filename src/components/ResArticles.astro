		</div>
	</header>

	<div class="res-articles__grid">
		{
			articles.map((a) => (
				<a href="#" class="res-article">
					<div class="res-article__meta">
						<span class={`res-article__cat res-article__cat--${a.catVariant}`}>{a.cat}</span>
						<span class="res-article__read">{a.read} read</span>
					</div>
					<h3 class="res-article__title">{a.title}</h3>
					<p class="res-article__excerpt">{a.excerpt}</p>
					<div class="res-article__footer">
						<span class="res-article__avatar" aria-hidden="true">{a.author}</span>
						<span class="res-article__author">{a.authorName}</span>
						<span class="res-article__date">{a.date}</span>
