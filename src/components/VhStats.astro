---
---

<section class="testimonial">
	<div class="testimonial__lead">
		<span class="testimonial__eyebrow">
			<span class="testimonial__eyebrow-dot" aria-hidden="true"></span>
			What our clubs are seeing
		</span>
		<blockquote class="testimonial__quote">
			An average Torny club bills <span class="testimonial__quote-accent">$68,400</span> in venue hire a year — that's
			92% they wouldn't have won on a "please enquire" button.
		</blockquote>
	</div>

	<div class="testimonial__stats">
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Avg time to book</span>
			<span class="testimonial__stat-value">2m 48s</span>
			<span class="testimonial__stat-note">From landing to deposit paid</span>
		</div>
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Conversion lift</span>
			<span class="testimonial__stat-value">+312%<span class="testimonial__stat-up"> ↑</span></span>
			<span class="testimonial__stat-note">vs. a "contact us" form</span>
		</div>
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Admin saved</span>
			<span class="testimonial__stat-value">11<span class="testimonial__stat-sub"> hrs/wk</span></span>
			<span class="testimonial__stat-note">No more back-and-forth emails</span>
		</div>
		<div class="testimonial__stat">
			<span class="testimonial__stat-label">Deposit capture</span>
			<span class="testimonial__stat-value">98.4%</span>
			<span class="testimonial__stat-note">Held on booking · auto-settled</span>
		</div>
	</div>
</section>
