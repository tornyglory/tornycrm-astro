---
const tables = [
	{ id: "T1", state: "booked" },
	{ id: "T2", state: "booked" },
	{ id: "T3", state: "held" },
	{ id: "T4", state: "booked" },
	{ id: "T5", state: "open" },
	{ id: "T6", state: "open" },
	{ id: "T7", state: "booked" },
	{ id: "T8", state: "booked" },
	{ id: "T9", state: "held" },
	{ id: "T10", state: "open" },
	{ id: "T11", state: "booked" },
	{ id: "T12", state: "booked" },
];
---

<section class="daily-ops">
	<header class="section-header">
		<div class="section-header__lead">
			<span class="section-header__eyebrow">
				<span class="section-header__eyebrow-dot" aria-hidden="true"></span>
				Daily operations
			</span>
			<h2 class="section-header__title">
				The small jobs that<br />
				used to eat your <span class="daily-ops__title-accent">Monday morning.</span>
			</h2>
		</div>
		<p class="section-header__body">
			Member sends a text asking if there's a table free Friday. Volunteer wants Saturday's draw list. Secretary needs
			the AGM to go out. All one tool.
		</p>
	</header>

	<div class="daily-ops__split">
		<article class="ops-card">
			<div class="ops-card__head">
				<span class="ops-card__icon" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 18 18">
						<circle cx="9" cy="9" r="3" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
						<circle cx="9" cy="9" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
					</svg>
				</span>
				<span class="ops-card__kicker">Table bookings</span>
			</div>
			<h3 class="ops-card__title">
				Friday-night dinners<br />
				book themselves.
			</h3>
			<p class="ops-card__body">
				Members pick a sitting from the portal. Floor plan, dietary notes, two-sitting turnover, SMS reminder the day
				before — no missed covers.
			</p>

			<div class="ops-card__mock">
				<div class="tables-mock__head">
					<div class="tables-mock__title">Friday · 6:30 sitting</div>
					<div class="tables-mock__count">42 / 80 seated</div>
				</div>
				<div class="tables-mock__grid" aria-label="Floor plan">
					{tables.map((t) => <div class={`tables-mock__cell tables-mock__cell--${t.state}`}>{t.id}</div>)}
				</div>
				<div class="tables-mock__legend">
					<span class="tables-mock__swatch">
						<span class="tables-mock__swatch-chip tables-mock__swatch-chip--booked" aria-hidden="true"></span>
						Booked
					</span>
					<span class="tables-mock__swatch">
						<span class="tables-mock__swatch-chip tables-mock__swatch-chip--held" aria-hidden="true"></span>
						Held
					</span>
					<span class="tables-mock__swatch">
						<span class="tables-mock__swatch-chip tables-mock__swatch-chip--open" aria-hidden="true"></span>
						Open
					</span>
				</div>
			</div>
		</article>

		<article class="ops-card">
			<div class="ops-card__head">
				<span class="ops-card__icon" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 18 18">
						<path
							d="M15 3 9 10M15 3l-3.5 11-2.5-4-4-2.5L15 3z"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
				<span class="ops-card__kicker">Communications</span>
			</div>
			<h3 class="ops-card__title">
				Newsletters members<br />
				actually open.
			</h3>
			<p class="ops-card__body">
				Compose once, segment by section, team or tier, deliver by email + SMS. On-brand without a designer. Analytics
				built in.
			</p>

			<div class="ops-card__mock comms-mock">
				<div class="comms-mock__row">
					<span class="comms-mock__icon comms-mock__icon--mint" aria-hidden="true">
						<svg width="16" height="16" viewBox="0 0 16 16">
							<path d="M2 4h12v8H2z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
							<path d="M2 4l6 5 6-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
						</svg>
					</span>
					<div class="comms-mock__body">
						<div class="comms-mock__title">November newsletter · sent</div>
						<div class="comms-mock__meta">1,284 members · 68% open · 24% clicks</div>
					</div>
					<div class="comms-mock__value">68%</div>
				</div>

				<div class="comms-mock__row">
					<span class="comms-mock__icon comms-mock__icon--tangerine" aria-hidden="true">
						<svg width="16" height="16" viewBox="0 0 16 16">
							<path d="M3 3h10v10l-3-2H3V3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
						</svg>
					</span>
					<div class="comms-mock__body">
						<div class="comms-mock__title">Spring Comp reminder · SMS</div>
						<div class="comms-mock__meta">32 entries · sending in 2 hr</div>
					</div>
					<div class="comms-mock__value comms-mock__value--small comms-mock__value--tangerine">Scheduled</div>
				</div>

				<div class="comms-mock__row">
					<span class="comms-mock__icon comms-mock__icon--primary" aria-hidden="true">
						<svg width="16" height="16" viewBox="0 0 16 16">
							<circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
							<path d="M8 4v4l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
						</svg>
					</span>
					<div class="comms-mock__body">
						<div class="comms-mock__title">AGM notice · draft</div>
						<div class="comms-mock__meta">To "Financial" segment · 1,112 rcpts</div>
					</div>
					<div class="comms-mock__value comms-mock__value--small comms-mock__value--muted">Draft</div>
				</div>
			</div>
		</article>
	</div>
</section>
