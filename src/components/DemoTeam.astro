---
---

<section class="demo-team">
	<header class="demo-team__head">
		<h2 class="demo-team__title">
			Who you'll <span class="demo-team__title-soft">meet.</span>
		</h2>
		<p class="demo-team__sub">
			Two humans in Wellington. One ran a cossie club for six years. The other wrote the Xero sync so the treasurers
			would stop pinging her at 10pm.
		</p>
	</header>

	<div class="demo-team__grid">
		<article class="demo-member">
			<span class="demo-member__avatar" aria-hidden="true">SK</span>
			<div class="demo-member__body">
				<div class="demo-member__head">
					<h3 class="demo-member__name">Sarah King</h3>
					<span class="demo-member__pronoun">she / her</span>
					<span class="demo-member__role">Onboarding lead</span>
				</div>
				<p class="demo-member__bio">
					Ex-secretary at Thorndon Club. Will spend the first five minutes asking what your committee actually hates
					about Mondays, then design the demo around that.
				</p>
				<span class="demo-member__status">
					<span class="demo-member__status-dot" aria-hidden="true"></span>
					Online now · Wellington
				</span>
			</div>
		</article>

		<article class="demo-member">
			<span class="demo-member__avatar demo-member__avatar--mint" aria-hidden="true">MK</span>
			<div class="demo-member__body">
				<div class="demo-member__head">
					<h3 class="demo-member__name">Mele Kaufusi, CA</h3>
					<span class="demo-member__pronoun">she / her</span>
					<span class="demo-member__role">Head of Finance</span>
				</div>
				<p class="demo-member__bio">
					Joins any demo where a treasurer is on the call. GST on bistro covers, grant acquittals, Xero chart of
					accounts — she's seen the gnarly version at your scale.
				</p>
				<span class="demo-member__status">
					<span class="demo-member__status-dot" aria-hidden="true"></span>
					Online now · Wellington
				</span>
			</div>
		</article>
	</div>
</section>
