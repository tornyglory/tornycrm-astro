---
import Layout from "../layouts/Layout.astro";
import PricingHero from "../components/PricingHero.astro";
import PricingPlan from "../components/PricingPlan.astro";
import Calculator from "../components/Calculator.astro";
import PricingFaq from "../components/PricingFaq.astro";
import FooterCta from "../components/FooterCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Pricing - $80/mo, Every Module - Torny"
	description="Less than a website. $80 a month for every module, then 5% of bookings and $1 per event entry when the money starts moving. No per-user fees, no setup fees. We only win when you do."
	ogImage="/og-pricing.png"
>
	<PricingHero />
	<div class="pricing__wrap">
		<PricingPlan />
	</div>
	<Calculator />
	<PricingFaq />
	<FooterCta />
	<Footer />
</Layout>
