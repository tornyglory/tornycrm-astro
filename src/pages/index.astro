---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Capabilities from "../components/Capabilities.astro";
import BuilderSpotlight from "../components/BuilderSpotlight.astro";
import MembershipSpotlight from "../components/MembershipSpotlight.astro";
import VenueSpotlight from "../components/VenueSpotlight.astro";
import DailyOps from "../components/DailyOps.astro";
